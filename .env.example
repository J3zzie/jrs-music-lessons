# Copy this file to .env and fill in real values. .env is gitignored and
# never committed, so this file documents what needs to be set.

# Used by scripts/generate-images.mjs and scripts/generate-icons.mjs.
OPENAI_API_KEY=

# Google Calendar Appointment Schedule booking link, shown on /book.
# Get this from Google Calendar -> Appointment schedules -> your schedule ->
# Share -> "Booking page link". Must be set as NEXT_PUBLIC_ so it's readable
# in the browser (it's used as both an <iframe> src and a link href).
# For production on Cloudflare Pages, also set this in the Pages project's
# Environment Variables, not just in this local file.
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=
